 {
     connect(&m_timer, &QTimer::timeout, this, &CanButtons::send);
     m_timer.start(100);
+#ifdef Q_OS_WIN
+    m_emuCanIn = new QUdpSocket(this);
+    if (m_emuCanIn->bind(QHostAddress::LocalHost, 45462))
+        connect(m_emuCanIn, &QUdpSocket::readyRead, this, &CanButtons::readEmuFrames);
+#endif
 }
 
