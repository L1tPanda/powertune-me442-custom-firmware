+void GPS::readEmulatorGps()
+{
+    rateset10hz = 1;   // no module to configure: skip setGPS10HZ(), which writes to the serial port
+    while (m_emuGpsIn && m_emuGpsIn->hasPendingDatagrams()) {
+        const QByteArray data = m_emuGpsIn->receiveDatagram().data();
+        for (const QByteArray &l : data.split('\n'))
+            if (l.trimmed().startsWith("$G"))
+                ProcessMessage(l.trimmed() + "\r\n");
+    }
+}
+
+// CUSTOM FIRMWARE: broadcast GPS speed and UTC time on CAN, id 0x6A0, 8 bytes:
+//   bytes 0-1  speed, km/h x 100 (little endian)   byte 5  hundredths of a second
+//   byte  2    UTC hours                           byte 6  1 = GPS fix valid, 0 = no fix
+//   byte  3    UTC minutes                         byte 7  satellites in view
+//   byte  4    UTC seconds
+// With no fix the speed is sent as 0.
+//
+// Also, ME442 vehicle-speed input (ME1_4.dbc, ME1_In_1): id 0x340, 8 bytes,
+//   bytes 0-1  Vehicle_Speed, km/h / 0.008 (little endian), rest 0
+// MEITE has Driven and Undriven Speed Source = CAN. Sent only with a valid fix: a false 0 km/h
+// at speed could upset gear detection or launch control, a missing frame can be detected.
+//
+// On the dash the frames go out on can0 (same bus as the ECU); in the Windows emulator they are
+// sent as candump-style text "6A0#..." to UDP 127.0.0.1:45460.
+void GPS::sendGpsCan(double kph, const QString &utc, bool valid)
+{
+    sendCanFrame(0x6A0, gpsFrame(kph, utc, valid));
+    if (valid) {
+        const quint16 vss = quint16(qBound(0.0, kph / 0.008 + 0.5, 65535.0));
+        QByteArray me(8, 0);
+        me[0] = char(vss & 0xFF);
+        me[1] = char(vss >> 8);
+        sendCanFrame(0x340, me);
+    }
+}
+
+QByteArray GPS::gpsFrame(double kph, const QString &utc, bool valid)
+{
+    const quint16 speed = valid ? quint16(qBound(0.0, kph * 100.0 + 0.5, 65535.0)) : 0;
+    QByteArray p(8, 0);
+    p[0] = char(speed & 0xFF);
+    p[1] = char(speed >> 8);
+    p[2] = char(utc.mid(0, 2).toInt());
+    p[3] = char(utc.mid(2, 2).toInt());
+    p[4] = char(utc.mid(4, 2).toInt());
+    p[5] = char(utc.mid(7, 2).toInt());
+    p[6] = char(valid ? 1 : 0);
+    p[7] = char(qBound(0, m_dashboard->gpsVisibleSatelites(), 255));
+    return p;
+}
+
+void GPS::sendCanFrame(quint32 id, const QByteArray &payload)
+{
+#ifdef Q_OS_WIN
+    if (!m_emuCanOut)
+        m_emuCanOut = new QUdpSocket(this);
+    const QByteArray text = QByteArray::number(id, 16).toUpper().rightJustified(3, '0') + "#" + payload.toHex().toUpper();
+    m_emuCanOut->writeDatagram(text, QHostAddress::LocalHost, 45460);   // can_monitor.py
+    m_emuCanOut->writeDatagram(text, QHostAddress::LocalHost, 45461);   // fake_me442.py (the "ECU")
+#else
+    if (!m_canOut) {
+        QString err;
+        m_canOut = QCanBus::instance()->createDevice("socketcan", "can0", &err);
+        if (!m_canOut)
+            return;                     // try again on the next GPS update
+        // Send-only: Qt queues every received frame until read, and the ECU sends hundreds a
+        // second. Accept only an extended id nothing uses, and drain whatever still arrives.
+        QCanBusDevice::Filter none;
+        none.frameId = 0x1FFFFFFFu;
+        none.frameIdMask = 0x1FFFFFFFu;
+        none.type = QCanBusFrame::DataFrame;
+        none.format = QCanBusDevice::Filter::MatchExtendedFormat;
+        m_canOut->setConfigurationParameter(QCanBusDevice::RawFilterKey,
+                                            QVariant::fromValue(QList<QCanBusDevice::Filter>{none}));
+        connect(m_canOut, &QCanBusDevice::framesReceived, this, [this]() { m_canOut->readAllFrames(); });
+        if (!m_canOut->connectDevice()) {
+            delete m_canOut;
+            m_canOut = nullptr;
+            return;
+        }
+    }
+    if (m_canOut->state() == QCanBusDevice::ConnectedState)
+        m_canOut->writeFrame(QCanBusFrame(id, payload));
+#endif
 }
 
